{
  "name": "beyond-companion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^6.0.0",
    "vite": "^8.3.0",
    "vitest": "^5.1.1",
    "@testing-library/react": "^16.3.3",
    "jsdom": "^29.1.1",
    "@playwright/test": "^1.65.1",
    "@axe-core/playwright": "^4.14.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
